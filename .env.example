# ==============================================================================
# Automated Multi-Platform Posting Service - Environment Configuration
# Copy this file to '.env' and provide your target platform credentials.
# Note: The service safely operates in test/mock mode if credentials are omitted.
# ==============================================================================

# Application Runtime Configuration
PORT=4000
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. LinkedIn API Configuration (OAuth 2.0 User Access Token)
# Permissions required: 'w_member_social'
# Author URN format: 'urn:li:person:abcdef1234'
# ------------------------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=your_linkedin_oauth_user_access_token
LINKEDIN_AUTHOR_URN=urn:li:person:your_member_id

# ------------------------------------------------------------------------------
# 2. Dev.to (Forem API) Configuration
# Generated under Dev.to Account Settings -> Extensions -> DEV Community API Keys
# ------------------------------------------------------------------------------
DEVTO_API_KEY=your_devto_forem_api_key

# ------------------------------------------------------------------------------
# 3. Hashnode (GraphQL API) Configuration
# Personal Access Token generated under Account Settings -> Developer
# Publication ID found under Blog Dashboard -> General Settings
# ------------------------------------------------------------------------------
HASHNODE_ACCESS_TOKEN=your_hashnode_personal_access_token
HASHNODE_PUBLICATION_ID=your_hashnode_publication_id

# ------------------------------------------------------------------------------
# 4. Mastodon API Configuration
# Bearer token generated under Preferences -> Development -> New Application
# MASTODON_BASE_URL allows pointing to any federated instance (e.g. https://mastodon.social)
# ------------------------------------------------------------------------------
MASTODON_ACCESS_TOKEN=your_mastodon_bearer_token
MASTODON_BASE_URL=https://mastodon.social

# ------------------------------------------------------------------------------
# 5. Telegram Bot API Configuration
# Bot token created via @BotFather (e.g. 123456789:ABCdefGHIjklMNO)
# Channel ID must be the public channel handle (e.g. @your_channel_name)
# Prerequisite: The bot MUST be added as an Administrator in the channel.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@your_public_channel_name
